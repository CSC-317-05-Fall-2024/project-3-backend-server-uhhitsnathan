<!DOCTYPE html>
<html lang="en">
<head>
    <title>Travel Guide</title>
    <link rel="stylesheet" href="/styles.css"/>
    <link rel="stylesheet" href="/restaurant-details-styles.css"/>
    <link rel="icon" type="image/png" href="images/icon.svg">
</head>
<body>
    <header></header>
    <nav></nav>
    
    <div class="restaurant-details">
        <img class="restaurant-details-img" src="<%= photo %>" alt="Image of <%= name %>"> <!-- Display the restaurant photo -->
        <div>
            <h1><%= name %></h1> <!-- Display the restaurant name -->
            <h2><%= address %></h2> <!-- Display the restaurant address -->
            <h2><%= phone %></h2> <!-- Display the restaurant phone -->
        </div>
    </div>

    <footer></footer>
    <script src="/scripts/header.js"></script>
</body>
</html>
